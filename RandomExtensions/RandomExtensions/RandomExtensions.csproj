<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>RandomExtensions.dmanning23</PackageId>
    <Version>5.0.0</Version>
    <Title>RandomExtensions.dmanning23</Title>
    <Authors>dmanning23</Authors>
    <description>Several useful extension methods for the .Net Random class</description>
    <PackageProjectUrl>https://github.com/dmanning23/RandomExtensions</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dmanning23/RandomExtensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>